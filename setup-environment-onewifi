#!/usr/bin/env bash
# Save _TOPDIR
_TOPDIR=`pwd`

LOCAL_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source $LOCAL_DIR/setup-environment

if [ $(grep '^BBLAYERS' conf/bblayers.conf | grep -c 'meta-cmf-bananapi') -eq 0 -a -d  $TOP_DIR/meta-cmf-bananapi ]
then
    cat >> conf/bblayers.conf <<EOF
BBLAYERS =+ "\${RDKROOT}/meta-cmf-bananapi"
EOF
fi

if [ ! -e ${_TOPDIR}/meta-cmf-filogic/recipes-ccsp/util/utopia_changes_applied ]; then
